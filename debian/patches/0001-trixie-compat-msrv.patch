From: Debian Packaging <packaging@nss-docker-ng>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: Trixie compatibility: cap dependency versions for rustc 1.85 (MSRV)

Debian Trixie ships rustc 1.85.0.  url >= 2.5.5 transitively pulls in
idna_adapter >= 1.2.2, which depends on ICU4X 2.2.0 and requires
rustc 1.86.  This patch adds version caps in Cargo.toml to resolve the
url/idna/ICU4X dependency chain to versions compatible with rustc 1.85,
and updates Cargo.lock accordingly (only the affected crates change).

--- a/Cargo.toml	2026-08-30 15:18:08.795437312 +0000
+++ b/Cargo.toml	2026-08-30 15:18:08.799006865 +0000
@@ -13,6 +13,7 @@
 edition = "2021"
 name = "nss-docker-ng"
 version = "1.2.1"
+rust-version = "1.85"
 authors = ["Patrick Kuijvenhoven <patrick.kuijvenhoven@gmail.com>"]
 build = false
 autolib = false
@@ -57,3 +58,14 @@
 
 [profile.release]
 strip = true
+
+# Transitive dependency version caps to maintain rustc 1.85 (Debian Trixie) compatibility.
+# url >= 2.5.5 and idna >= 1.1.0 pull in idna_adapter >= 1.2.2 which requires rustc >= 1.86.
+[dependencies.url]
+version = ">=2.1, <2.5.5"
+
+[dependencies.idna]
+version = ">=1, <1.1"
+
+[dependencies.idna_adapter]
+version = ">=1, <1.2.1"

